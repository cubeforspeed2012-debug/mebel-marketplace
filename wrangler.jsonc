{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Имя обязано совпадать с проектом в панели Cloudflare,
  // иначе сборка развернёт сайт под другим именем.
  "name": "mebel-marketplace",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Служебный адрес вида mebel-marketplace.<аккаунт>.workers.dev включён,
  // но только как переадресация: proxy.ts сразу отправляет каждого
  // на top-mebel.uz, так что это имя никто не видит и вход живёт в одном месте.
  //
  // Выключать его совсем нельзя: у людей остались старые ссылки и иконки
  // на экране телефона, сохранённые с этого адреса. Выключенный, он
  // показывал пустую страницу Cloudflare «There is nothing here yet»,
  // и выглядело это как упавший сайт.
  "workers_dev": true,

  // Основной адрес. custom_domain означает, что Cloudflare сам заведёт
  // DNS-запись и выпустит сертификат — руками в панели ничего не нужно.
  // Прописывать это можно только после того, как домен появился в аккаунте:
  // иначе выкладка падает с ошибкой «зона не найдена».
  "routes": [
    { "pattern": "top-mebel.uz", "custom_domain": true },
    { "pattern": "www.top-mebel.uz", "custom_domain": true }
  ],

  // Не стирать при выкладке то, что добавлено в панели вручную.
  // Без этого wrangler считает конфиг единственной правдой и вычищает
  // всё остальное окружение — так у нас пропадал ключ помощника после
  // каждого пуша, хотя в панели он был сохранён.
  "keep_vars": true,

  // Ключи Supabase держим здесь, а не в панели: переменные, добавленные
  // руками в панели, стираются при каждой сборке (wrangler deploy
  // перезаписывает окружение конфигом), и сайт падает.
  //
  // Оба значения публичные — они и так уходят в браузер каждому посетителю.
  // Данные защищены правилами доступа внутри самой базы, а не секретностью
  // этого ключа. Секретные ключи (service_role, токен Telegram) сюда не
  // кладём — только через Settings → Variables and Secrets как Secret.
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://haxmubqjipkwgmeagezm.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_N9aZTyHKQY3D32SsDNibeg_7gB8ESB7",

    // Имя бота — не секрет: его и так видно в Telegram каждому.
    // Сам токен сюда класть нельзя, файл лежит в GitHub. Токен и
    // TELEGRAM_WEBHOOK_SECRET добавляются в панели как Secret.
    "TELEGRAM_BOT_USERNAME": "mebel717_bot"
  },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
