{
  "name": "air-max-dn-commercial",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nike Air Max Dn (Dynamic Air Edition) - 30s / 60fps spec commercial. Remotion + React Three Fiber + GSAP + Tailwind, with a Blender asset pipeline.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/generate-score.ts && node scripts/bake-choreography.ts",
    "dev": "remotion studio src/index.ts",
    "score": "node scripts/generate-score.ts",
    "bake": "node scripts/bake-choreography.ts",
    "verify": "node scripts/verify-geometry.ts",
    "typecheck": "tsc --noEmit",
    "stills": "node scripts/preview-stills.ts",
    "render": "remotion render src/index.ts AirMaxDn out/air-max-dn.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k",
    "render:uhd": "remotion render src/index.ts AirMaxDn-UHD out/air-max-dn-uhd.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-codec=aac --audio-bitrate=320k",
    "render:prores": "remotion render src/index.ts AirMaxDn out/air-max-dn.mov --codec=prores --prores-profile=4444",
    "render:blender-plates": "remotion render src/index.ts AirMaxDn out/air-max-dn-blender.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p --props={\"plate\":\"blender\"}"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource-variable/syne": "5.3.0",
    "@react-three/fiber": "9.8.1",
    "@react-three/postprocessing": "3.1.3",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/three": "4.0.534",
    "@remotion/zod-types": "4.0.534",
    "gsap": "3.15.0",
    "postprocessing": "6.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.534",
    "three": "0.186.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "@remotion/tailwind-v4": "4.0.534",
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "@types/three": "0.186.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
