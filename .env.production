# Публичные ключи Supabase, нужные во время сборки.
#
# Next.js подставляет переменные с приставкой NEXT_PUBLIC_ прямо в код
# страниц при сборке — без них не заработают вход и загрузка фото в браузере.
#
# Оба значения и так уходят в браузер каждому посетителю сайта. Данные
# защищены правилами доступа внутри базы, а не секретностью этого ключа.
# Секретные ключи (service_role, токен Telegram-бота) сюда не добавлять —
# только в Cloudflare: Settings → Variables and Secrets → тип Secret.
NEXT_PUBLIC_SUPABASE_URL=https://haxmubqjipkwgmeagezm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_N9aZTyHKQY3D32SsDNibeg_7gB8ESB7
